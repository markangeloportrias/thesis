RewriteEngine On
Options -MultiViews

# Keep clean, extension-free entry URLs. These are internal rewrites, so the
# existing HTML files, relative assets, session checks, and page scripts remain
# unchanged at runtime.
# Avoid a trailing slash because these pages use relative asset URLs.
RewriteRule ^(login|student|instructor|admin|admin-dashboard)/$ /THESIS6/$1 [R=302,L,NE]
RewriteRule ^login$ login.html [L]
RewriteRule ^student$ student.html [L]
RewriteRule ^instructor$ instructor.html [L]
RewriteRule ^admin$ admin-dashboard.html [L]
RewriteRule ^admin-dashboard$ admin-dashboard.html [L]

# Canonicalize direct legacy URLs so .html is not left visible in the address
# bar. THE_REQUEST prevents this redirect from firing after an internal rewrite.
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/(login|student|instructor|admin|admin-dashboard)\.html(?:[?\s]) [NC]
RewriteRule ^(login|student|instructor|admin|admin-dashboard)\.html$ /THESIS6/$1 [R=302,L,NE]
